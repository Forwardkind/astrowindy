---
import { SITE } from 'astrowind:config';
// import { Image } from 'astro:assets';
// import fkLogo from './src/assets/images/fk-logo.svg';
import { Image } from 'astro:assets';
import fkLogo from '../assets/images/fk-logo.svg';
---

<span
  class="self-center items-center flex ml-2 rtl:ml-0 rtl:mr-2 text-xl font-semibold md:text-xl text-gray-900 whitespace-nowrap dark:text-white"
>
  <Image src={fkLogo} alt="Forwardkind logo" width="50" height="50" />
  {SITE?.name}
</span>
