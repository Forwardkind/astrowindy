---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import CallToAction2 from '~/components/widgets/CallToAction2.astro';

import Features from '~/components/widgets/Features.astro';

const metadata = {
  title: 'Forwardkind — Amplifying Impact, Collectively',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero actions={[{ text: 'Get notified when we launch', href: '#cta2', icon: 'tabler:send' }]}>
    <Fragment slot="title">
      We believe in <span class="text-accent text-green-500">human potential</span>.
    </Fragment>

    <Fragment slot="subtitle">
      Forwardkind is building a member-owned ecosystem that multiplies human potential — expanding access to
      transformational work and amplifying the collective impact of purpose-driven people.
    </Fragment>
  </Hero>

  <!-- Features Widget *************** -->

  <Features
    id="features"
    title="What we're building"
    subtitle="By bringing together coaches, educators, creatives, and other transformation professionals into a shared-ownership cooperative, we expand access to trusted growth experiences and strengthen the collective impact of purpose-driven people."
    columns={3}
    items={[
      {
        title: 'Shared Ownership',
        description:
          'As a member-owned cooperative, we are aligned toward long-term impact and sustainable growth rather than extraction.',
        icon: 'tabler:heart-handshake',
      },
      {
        title: 'Expanded Access',
        description:
          'We believe everyone should have access to a rich diversity of transformative life experiences instead of a select few.',
        icon: 'tabler:lock-open-off',
      },
      {
        title: 'Amplified Impact',
        description:
          'We believe the collective impact of transformation professionals is amplified when we are connected, supported, and aligned.',
        icon: 'tabler:arrows-maximize',
      },
      {
        title: 'Collective Growth',
        description:
          'We create pathways from personal transformation to thriving and contribution — strengthening both practitioners and participants.',
        icon: 'tabler:seedling',
      },
      {
        title: 'Human Connectivity',
        description:
          'Through meaningful human kinship, we are helping to make purpose-driven growth less isolated and more connected.',
        icon: 'tabler:affiliate',
      },
      {
        title: 'Open Source',
        description:
          'Ultimately, we belong to something bigger than individual ourselves, as we contribute to the growth of the transformation economy.',
        icon: 'tabler:recycle',
      },
    ]}
  />

  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="Meet the FAM"
    subtitle="Forwardkind Cooperative is made possible by generous volunteer advisory members who share our belief in
        expanding access to transformational work while amplifying the collective impact of purpose-driven people."
    testimonials={[
      {
        testimonial: ``,
        name: 'Christine Walsh',
        job: 'Steamboat Springs, CO',
        image: {
          src: '../src/assets/images/christine-walsh.jpg',
          alt: 'Christine Walsh Image',
        },
      },
      {
        testimonial: ``,
        name: 'Paul Cohen',
        job: 'Boulder, CO',
        image: {
          src: '../src/assets/images/paul-cohen.jpg',
          alt: 'Paul Cohen Image',
        },
      },
      {
        testimonial: ``,
        name: 'Amanda Eldridge',
        job: 'Denver, CO',
        image: {
          src: '../src/assets/images/amanda-eldridge.jpeg',
          alt: 'Amanda Eldridge Image',
        },
      },
      {
        testimonial: ``,
        name: 'Ken Sagendorf',
        job: 'Denver, CO',
        image: {
          src: '../src/assets/images/ken-sagendorf.jpg',
          alt: 'Ken Sagendorf Image',
        },
      },
      {
        testimonial: ``,
        name: 'Christine Louden',
        job: 'Trinidad, CO',
        image: {
          src: '../src/assets/images/christine-louden.jpg',
          alt: 'Christine Louden Image',
        },
      },
      {
        testimonial: ``,
        name: 'Thayer Hirsh',
        job: 'Frisco, CO',
        image: {
          src: '../src/assets/images/thayer-hirsh.png',
          alt: 'Thayer Hirsh Image',
        },
      },
      {
        testimonial: ``,
        name: 'Heidi Steltzer',
        job: 'Durango, CO',
        image: {
          src: '../src/assets/images/heidi-steltzer.png',
          alt: 'Heidi Steltzer Image',
        },
      },
      {
        testimonial: ``,
        name: 'Joze Petrich',
        job: 'Trinidad, CO',
        image: {
          src: '../src/assets/images/joze-petrich.png',
          alt: 'Joze Petrich Image',
        },
      },
      {
        testimonial: ``,
        name: 'Thedo Remmelink',
        job: 'Steamboat Springs, CO',
        image: {
          src: '../src/assets/images/thedo-remmelink.jpg',
          alt: 'Thedo Remmelink Image',
        },
      },
      {
        testimonial: ``,
        name: 'Paula Brown',
        job: 'Steamboat Springs, CO',
        image: {
          src: '../src/assets/images/paula-brown.png',
          alt: 'Paula Brown Image',
        },
